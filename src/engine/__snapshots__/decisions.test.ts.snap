exports[`buildThumbnailRequest > puts title, channel and the image in state and one noul per Thumbnail rule 1`] = `
{
  "model": "cloudflare/clef-flash",
  "provider": {
    "allow_fallbacks": false,
    "data_collection": "deny",
    "order": [
      "cloudflare",
    ],
  },
  "questions": {
    "R4": {
      "instructions": "The thumbnail image shows: Shocked faces, red arrows or circled objects",
      "type": "noul",
    },
    "R7": {
      "instructions": "The thumbnail image shows: A person pointing at the camera",
      "type": "noul",
    },
    "R8": {
      "instructions": "The thumbnail image shows: A man singing or dancing",
      "type": "noul",
    },
  },
  "state": [
    "Title: 80s pop singer performs his biggest hit live",
    "Channel: Retro Music Vault",
    {
      "image_url": {
        "url": "data:image/jpeg;base64,AAAA",
      },
      "type": "image_url",
    },
  ],
}
`;
