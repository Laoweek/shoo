                "outcome",
                "rule",
                "probability",
              ],
              "type": "object",
            },
            "type": "array",
          },
        },
        "required": [
          "results",
        ],
        "type": "object",
      },
      "strict": true,
    },
    "type": "json_schema",
  },
  "temperature": 0,
}
