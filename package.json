{
  "name": "shoo",
  "description": "Clear unwanted video recommendations",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Laoweek/shoo",
  "repository": "github:Laoweek/shoo",
  "bugs": "https://github.com/Laoweek/shoo/issues",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project live",
    "bench": "vitest bench --run --project 'unit (bench)'",
    "size": "node scripts/check-size.mjs",
    "check": "pnpm compile && pnpm lint && pnpm test && pnpm build && pnpm build:firefox && pnpm size",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "4.0.0",
    "@wxt-dev/i18n": "0.2.8",
    "lucide-preact": "1.52.0",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@fontsource-variable/figtree": "5.3.0",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
